{
  "version": "3.0.0-firewall",
  "description": "FirewallXPL-Forge: module-to-device-class mapping for perimeter/waf/vpn/nac/lb hierarchy.",
  "operational_policy": {
    "prohibited_in_project_scope": [
      "operational_botnets_and_c2_infrastructure",
      "malware_persistence_campaigns_against_third_parties",
      "intentional_device_bricking_or_destructive_floods_outside_authorized_lab"
    ],
    "note": "FirewallXPL-Forge does not provide turnkey botnet/C2, zombie recruitment, or bricking modules. Use authorized lab tooling for controlled resilience tests."
  },
  "default_allow_classes": [
    "perimeter",
    "waf",
    "vpn",
    "nac",
    "lb"
  ],
  "domain_defaults": {
    "exploits": [
      "perimeter",
      "waf",
      "vpn",
      "nac",
      "lb"
    ],
    "creds": [
      "perimeter",
      "waf",
      "vpn",
      "nac",
      "lb"
    ]
  },
  "prefix_rules": [
    {
      "prefix": "perimeter/generic/",
      "allow": ["perimeter", "waf", "vpn", "nac", "lb"]
    },
    {
      "prefix": "perimeter/fortinet/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/cisco/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/paloalto/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/checkpoint/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/sonicwall/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/sophos/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/watchguard/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/juniper/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/pfsense/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/ipfire/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "perimeter/zyxel/",
      "allow": ["perimeter"]
    },
    {
      "prefix": "waf/",
      "allow": ["waf"]
    },
    {
      "prefix": "vpn/",
      "allow": ["vpn"]
    },
    {
      "prefix": "nac/",
      "allow": ["nac"]
    },
    {
      "prefix": "lb/",
      "allow": ["lb"]
    }
  ],
  "file_overrides": {
    "perimeter/generic/http_form_char_by_char_oracle.py": [
      "perimeter",
      "waf",
      "vpn",
      "nac",
      "lb"
    ]
  },
  "note": "Wi-Fi/BLE tooling: WirelessXPL-Forge."
}
